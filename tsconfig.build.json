{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "Node16",
    "moduleResolution": "Node16",
    "composite": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {},
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.mts"],
  "exclude": ["src/**/*.test.ts"]
}
